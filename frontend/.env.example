# Copy to .env.local and fill in your key (.env.local is gitignored).

# Gemini Live API key from Google AI Studio. Server-side only: the Vite dev
# /token endpoint mints short-lived ephemeral tokens from it, so it is never
# exposed to the browser bundle. (No VITE_ prefix — that keeps it server-side.)
GEMINI_API_KEY=

# Data source: mock | live (Gemini caller) | analyze (Gemini analyses a 2-person call) | ws
# The demo defaults to the 2-person Analysis view.
VITE_SOURCE=analyze
