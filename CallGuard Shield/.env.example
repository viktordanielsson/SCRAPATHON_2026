# Copy to .env.local (gitignored) and fill in your key.

# Gemini API key from Google AI Studio. Server-side only: the SENTINEL server
# functions (src/lib/sentinel.server.ts) mint short-lived ephemeral tokens and
# run the /analyze detector from it, so it never reaches the browser bundle.
# No VITE_ prefix — that keeps it server-side.
GEMINI_API_KEY=
